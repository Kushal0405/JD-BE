{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/fetch-jobs",
      "schedule": "0 3 * * *"
    }
  ]
}
